int main(){
    int temp;
    cout << "Enter a Temperature (F): ";
    cin >> temp;
    
    if(temp >= 88){
        cout << "It's Hot!" << endl;
    }else if(temp >= 70){
        cout << "That's Mild "<< endl;
    }else if (temp >= 60){
